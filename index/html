        let currentMode = 'in-place';
        let currentSize = 'mini';
        let selections = { sponge1: null, sponge2: null, sponge3: null, filling1: null, filling2: null, filling3: null, decor: null };
        let pendingSelection = null;

        function setMode(mode) {
            currentMode = mode;
            document.querySelectorAll('.mode-btn').forEach(btn => btn.classList.remove('active'));
            event.target.closest('.mode-btn').classList.add('active');
            selections = { sponge1: null, sponge2: null, sponge3: null, filling1: null, filling2: null, filling3: null, decor: null };
            updatePrices();
            updateBadges();
        }

        function selectSize(size) {
            currentSize = size;
            document.querySelectorAll('.size-option').forEach(opt => opt.classList.remove('active'));
            document.getElementById('size-' + size).classList.add('active');
            updatePrices();
        }

        function updatePrices() {
            const basePrice = SIZES[currentMode][currentSize];
            let extraPrice = 0;
            Object.values(selections).forEach(sel => { if (sel) extraPrice += sel.price; });
            document.getElementById('base-price').textContent = basePrice.toLocaleString() + ' ₽';
            document.getElementById('extra-price').textContent = extraPrice.toLocaleString() + ' ₽';
            document.getElementById('total-price').textContent = (basePrice + extraPrice).toLocaleString() + ' ₽';
            document.getElementById('price-mini').textContent = SIZES[currentMode]['mini'].toLocaleString() + ' ₽';
            document.getElementById('price-standard').textContent = SIZES[currentMode]['standard'].toLocaleString() + ' ₽';
            document.getElementById('price-large').textContent = SIZES[currentMode]['large'].toLocaleString() + ' ₽';
        }

        function updateBadges() {
            ['sponge1', 'sponge2', 'sponge3', 'filling1', 'filling2', 'filling3', 'decor'].forEach(layer => {
                const layerEl = document.getElementById('layer-' + layer);
                if (layerEl) {
                    if (selections[layer]) {
                        layerEl.classList.add('selected');
                    } else {
                        layerEl.classList.remove('selected');
                    }
                }
            });
        }

        function openLayerModal(layer) {
            const modal = document.getElementById('layer-modal');
            const title = document.getElementById('modal-title');
            const optionsDiv = document.getElementById('modal-options');
            let options = [];
            
            if (layer.includes('sponge')) {
                title.innerHTML = 'Выберите тип коржа';
                options = INGREDIENTS.sponge;
            } else if (layer.includes('filling')) {
                title.innerHTML = 'Выберите начинку';
                options = INGREDIENTS.filling;
            } else if (layer === 'decor') {
                title.innerHTML = 'Выберите декор';
                options = INGREDIENTS.decor[currentMode];
            }
            
            optionsDiv.innerHTML = '';
            options.forEach(opt => {
                const isAvailable = opt.available ? opt.available.includes(currentMode) : true;
                const isSelected = selections[layer] && selections[layer].id === opt.id;
                const card = document.createElement('div');
                card.className = 'option-card ' + (isSelected ? 'selected' : '');
                if (!isAvailable) card.style.opacity = '0.5';
                card.innerHTML = `
                    <span class="option-icon">${opt.icon}</span>
                    <div class="option-info">
                        <span class="option-name">${opt.name}</span>
                        <span class="option-desc">${opt.desc}</span>
                        ${opt.time ? `<span class="option-desc">${opt.time}</span>` : ''}
                        ${!isAvailable ? '<span class="option-tag tag-order-only">Только на заказ</span>' : 
                          opt.available && opt.available.includes('in-place') ? '<span class="option-tag tag-available">Доступно</span>' : ''}
                    </div>
                    <span class="option-price">+${opt.price} ₽</span>
                `;
                if (isAvailable) {
                    card.onclick = () => selectOption(layer, opt);
                }
                optionsDiv.appendChild(card);
            });
            modal.classList.add('active');
        }

        function selectOption(layer, option) {
            const spongeLayers = ['sponge1', 'sponge2', 'sponge3'];
            const fillingLayers = ['filling1', 'filling2', 'filling3'];
            
            let otherSelections = [];
            if (spongeLayers.includes(layer)) {
                otherSelections = fillingLayers.map(l => selections[l]).filter(Boolean);
            } else if (fillingLayers.includes(layer)) {
                otherSelections = spongeLayers.map(l => selections[l]).filter(Boolean);
            }
            
            for (let other of otherSelections) {
                const conflictKey1 = option.id + '-' + other.id;
                const conflictKey2 = other.id + '-' + option.id;
                if (COMPATIBILITY[option.id] && COMPATIBILITY[option.id].includes(other.id)) {
                    pendingSelection = { layer, option };
                    showWarning(COMPATIBILITY_REASONS[conflictKey1] || COMPATIBILITY_REASONS[conflictKey2] || 'Эти ингредиенты могут не сочетаться по вкусу.');
                    return;
                }
            }
            confirmSelection(layer, option);
        }

        function showWarning(text) {
            document.getElementById('warning-text').textContent = text;
            document.getElementById('warning-modal').classList.add('active');
        }

        function closeWarning() {
            document.getElementById('warning-modal').classList.remove('active');
            pendingSelection = null;
        }

        function confirmWarning() {
            if (pendingSelection) {
                confirmSelection(pendingSelection.layer, pendingSelection.option);
            }
            closeWarning();
        }

        function confirmSelection(layer, option) {
            selections[layer] = option;
            updatePrices();
            updateBadges();
            closeModal();
        }

        function closeModal() {
            document.getElementById('layer-modal').classList.remove('active');
        }

        function resetConstructor() {
            selections = { sponge1: null, sponge2: null, sponge3: null, filling1: null, filling2: null, filling3: null, decor: null };
            updatePrices();
            updateBadges();
        }

        function openCart() {
            const modal = document.getElementById('cart-modal');
            const content = document.getElementById('cart-content');
            let html = '';
            const sizeNames = { mini: 'Мини (10 см)', standard: 'Стандарт (16 см)', large: 'Большой (22 см)' };
            
            html += `<div class="cart-item">
                <span class="cart-item-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#5D2E1E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <div class="cart-item-details">
                    <h4>Размер: ${sizeNames[currentSize]}</h4>
                    <p>Режим: ${currentMode === 'in-place' ? 'В заведении' : 'На заказ'}</p>
                </div>
            </div>`;
            
            const layerNames = {
                sponge1: 'Корж 1 (нижний)', sponge2: 'Корж 2 (средний)', sponge3: 'Корж 3 (верхний)',
                filling1: 'Начинка 1', filling2: 'Начинка 2', filling3: 'Начинка 3', decor: 'Декор'
            };
            
            Object.entries(selections).forEach(([key, val]) => {
                if (val) {
                    html += `<div class="cart-item">
                        <span class="cart-item-icon">${val.icon}</span>
                        <div class="cart-item-details">
                            <h4>${layerNames[key]}: ${val.name}</h4>
                            <p>${val.desc} ${val.price > 0 ? '(+' + val.price + ' ₽)' : '(базовая)'}</p>
                        </div>
                    </div>`;
                }
            });
            
            const basePrice = SIZES[currentMode][currentSize];
            let extraPrice = 0;
            Object.values(selections).forEach(sel => { if (sel) extraPrice += sel.price; });
            
            html += `<div style="background:var(--cream);padding:15px;border-radius:15px;margin-top:15px;">
                <div class="summary-row"><span>Базовая цена:</span><span>${basePrice.toLocaleString()} ₽</span></div>
                <div class="summary-row"><span>Доплаты:</span><span>${extraPrice.toLocaleString()} ₽</span></div>
                <div class="summary-row total"><span>ИТОГО:</span><span>${(basePrice + extraPrice).toLocaleString()} ₽</span></div>
            </div>`;
            
            content.innerHTML = html;
            modal.classList.add('active');
        }

        function closeCart() {
            document.getElementById('cart-modal').classList.remove('active');
        }

        function submitOrder() {
            alert('Спасибо за заказ! Мы свяжемся с вами в ближайшее время для подтверждения. Ваша мелодия вкуса уже звучит на нашей кухне!');
            closeCart();
        }

        // Scroll animations
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

        // Initialize
        updatePrices();
        updateBadges();
    </script>
</body>
